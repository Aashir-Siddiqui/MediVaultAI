# ============================
# Root MERN Project Gitignore
# ============================

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# OS generated files
.DS_Store
Thumbs.db

# Environment files (Root, Client, Server)
.env
.env.local
.env.*.local
client/.env
server/.env

# Node modules (Root, Client, Server)
node_modules/
client/node_modules/
server/node_modules/

# Build output
dist/
build/
.client-build/
server/build/

# Cache
.cache/
client/.vite/
client/.next/
client/.turbo/

# Editor folders
.vscode/
.idea/
*.swp

# Temporary folders
tmp/
temp/
eng.traineddata

# Optional: lock files (if you want)
# package-lock.json
# yarn.lock

